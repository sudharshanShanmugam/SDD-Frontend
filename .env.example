# Application
VITE_APP_NAME="SDD Platform"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="development"

# API Configuration
VITE_API_BASE_URL="http://localhost:8000"
VITE_API_VERSION="v1"
VITE_API_TIMEOUT=30000

# WebSocket
VITE_WS_URL="ws://localhost:8000"
VITE_WS_PATH="/socket.io"
VITE_WS_RECONNECT_ATTEMPTS=5
VITE_WS_RECONNECT_DELAY=1000

# Authentication
VITE_AUTH_TOKEN_KEY="sdd_access_token"
VITE_AUTH_REFRESH_TOKEN_KEY="sdd_refresh_token"
VITE_AUTH_TOKEN_EXPIRY=3600
VITE_OAUTH_GOOGLE_CLIENT_ID=""
VITE_OAUTH_GITHUB_CLIENT_ID=""

# Feature Flags
VITE_FEATURE_AI_ASSISTANT=true
VITE_FEATURE_COLLABORATION=true
VITE_FEATURE_ANALYTICS=true
VITE_FEATURE_GANTT=true
VITE_FEATURE_EXPORT_PDF=true

# Analytics
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_KEY=""

# Sentry Error Tracking
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="development"
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# File Upload
VITE_MAX_FILE_SIZE_MB=50
VITE_ALLOWED_FILE_TYPES="pdf,doc,docx,xls,xlsx,png,jpg,jpeg,gif,svg,txt,md"

# AI Configuration
VITE_AI_MODEL_DEFAULT="gpt-4o"
VITE_AI_CONFIDENCE_THRESHOLD=0.7

# Pagination
VITE_DEFAULT_PAGE_SIZE=25
VITE_MAX_PAGE_SIZE=100
